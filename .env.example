# Contact form email delivery (server-side, Cloudflare Pages Function /api/contact).
# Set these in Cloudflare Pages -> Settings -> Variables and Secrets.
# For local `npx wrangler pages dev out`, put them in .dev.vars (never commit it).
RESEND_API_KEY=
# Optional. Defaults: office@bnx24inc.com and "BNX 24 Website <website@bnx24inc.com>".
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional. Extra origins allowed to post to /api/contact, comma-separated.
ALLOWED_ORIGINS=

# Optional build-time override of the form endpoint (default /api/contact).
# Compiled into browser code: never put a secret here.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
