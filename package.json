{
  "name": "bnx24-consulting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve-out.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "brand:render": "node scripts/render-brand-assets.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:e2e",
    "test:form": "NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://forms.invalid/bnx24-test sh -c 'next build && playwright test tests/contact.spec.ts' ; next build"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
